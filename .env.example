NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:4000

# PostgreSQL (Docker/production) or embedded PGlite for local demo
# DATABASE_URL=postgres://tracker:tracker@localhost:5432/task_tracker
DATABASE_URL=pglite://local

# Redis (optional — in-memory cache is used if Redis is unreachable)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-this-with-a-unique-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Task Tracker <noreply@example.com>
NOTIFY_EMAIL_TO=

SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FCM_SERVER_KEY=
